#!/bin/sh
# commit に handout.pdf と Eleventy 出力 (_site) を載せる。
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ ! -d node_modules ]; then
  npm ci
fi
make -B handouts
npm run build

rm -rf _site/lite _site/exercises/solutions
find _site -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

git add -- _site
node -e '
const fs = require("fs");
const decks = require("./src/_data/decks.json");
for (const d of decks) {
  const slides = "src/" + d.dir + "/slides.md";
  if (fs.existsSync(slides)) console.log(slides);
  const pdf = "src/" + d.dir + "/handout.pdf";
  if (fs.existsSync(pdf)) console.log(pdf);
}
' | xargs git add --
