#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');
const yaml = require('js-yaml');

const KIT = path.join(__dirname, '..');
const COURSE = path.join(KIT, 'scaffold');
const CODES = new Set(['python', 'webllm', 'none']);

function fail(msg) {
  console.error(msg);
  process.exit(1);
}

function usage() {
  console.log(`Usage:
  slidekit init "title" [dir]
  slidekit create <id> [title] [--code python|webllm|none] [--model ID] [--models ID,ID]
  slidekit gist [--check | hook | add <file>]
  slidekit build
  slidekit serve [--port N]

init    new course, with this package copied into vendor/slidekit
create  add src/<id>/slides.md (Reveal). A dir with only PDFs is served as-is.
gist    sync notebooks to GitHub Gists (Colab)
build   write _site
serve   build and serve _site`);
}

function parse(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--title' || a === '--code' || a === '--model' || a === '--models' || a === '--port') {
      const v = argv[++i];
      if (!v) fail('missing value for ' + a);
      out[a.slice(2)] = v;
      continue;
    }
    if (a.startsWith('-')) fail('unknown flag ' + a);
    out._.push(a);
  }
  return out;
}

function slug(title) {
  const s = String(title)
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  return s || 'course';
}

function writeFile(dest, body) {
  if (fs.existsSync(dest)) {
    console.log('skip  ' + dest);
    return false;
  }
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.writeFileSync(dest, body);
  console.log('write ' + dest);
  return true;
}

function fill(s, vars) {
  return s.replace(/__([A-Z0-9_]+)__/g, (_, k) =>
    Object.prototype.hasOwnProperty.call(vars, k) ? vars[k] : '__' + k + '__');
}

function walk(dir, acc = []) {
  for (const name of fs.readdirSync(dir)) {
    const p = path.join(dir, name);
    if (fs.statSync(p).isDirectory()) walk(p, acc);
    else acc.push(p);
  }
  return acc;
}

function relTemplate(abs) {
  const rel = path.relative(COURSE, abs);
  return rel === 'gitignore' ? '.gitignore' : rel;
}

function copyKit(from, to) {
  const src = path.resolve(from);
  const dest = path.resolve(to);
  if (dest === src || dest.startsWith(src + path.sep)) {
    fail('refusing to copy kit into itself');
  }
  fs.cpSync(src, dest, {
    recursive: true,
    filter: (p) => {
      const base = path.basename(p);
      return base !== '.git' && base !== 'node_modules';
    },
  });
}

function init(title, dir) {
  if (!title) fail('slidekit init "title"');
  const dest = path.resolve(dir || slug(title));
  const name = path.basename(dest).replace(/[^a-zA-Z0-9._-]+/g, '-') || 'course';
  const vars = { TITLE: title, NAME: name };
  fs.mkdirSync(dest, { recursive: true });
  for (const file of walk(COURSE)) {
    writeFile(path.join(dest, relTemplate(file)), fill(fs.readFileSync(file, 'utf8'), vars));
  }
  writeFile(path.join(dest, 'assets/.gitkeep'), '');
  const vendor = path.join(dest, 'vendor/slidekit');
  if (!fs.existsSync(vendor)) {
    copyKit(KIT, vendor);
    console.log('write ' + vendor);
  } else {
    console.log('skip  ' + vendor);
  }
  const npm = spawnSync('npm', ['install'], { cwd: dest, stdio: 'inherit' });
  if (npm.status !== 0) fail('npm install failed');
  for (const name of ['slidekit', 'slidekit-handout', 'slidekit-jupyter-lite']) {
    const p = path.join(dest, 'bin', name);
    if (fs.existsSync(p)) fs.chmodSync(p, 0o755);
  }
  console.log('\nNext:\n  cd ' + dest + '\n  slidekit create 01');
}

function dumpYaml(obj) {
  return yaml.dump(obj, { lineWidth: 80 }).trim() + '\n';
}

function create(id, title, code, model, models) {
  if (!id || /[\\/]/.test(id) || id === '.' || id === '..') {
    fail('slidekit create <id>');
  }
  if (!CODES.has(code)) fail('--code must be python, webllm, or none');
  const root = process.cwd();
  const dir = path.join(root, 'src', id);
  const slides = path.join(dir, 'slides.md');
  if (fs.existsSync(slides)) fail('already exists: ' + slides);
  const heading = title || id;
  writeFile(
    slides,
    fill(fs.readFileSync(path.join(KIT, 'theme/slides.md'), 'utf8'), {
      TITLE: heading,
    }),
  );
  const meta = {};
  if (code !== 'python') meta.code = code;
  if (model) meta.model = model;
  if (models) {
    meta.models = models.split(',').map((s) => s.trim()).filter(Boolean);
  }
  if (Object.keys(meta).length) {
    writeFile(path.join(dir, 'deck.yaml'), dumpYaml(meta));
  }
}

const raw = process.argv.slice(2);
const cmd = raw[0];
if (cmd === 'init' || cmd === 'create' || cmd === 'deck') {
  const argv = parse(raw);
  if (cmd === 'init') init(argv._[1], argv._[2]);
  else {
    if (!argv._[1]) fail('slidekit create <id>');
    create(
      argv._[1],
      argv._[2] || argv.title,
      argv.code || 'python',
      argv.model,
      argv.models,
    );
  }
} else if (cmd === 'build') {
  require('../lib/build.cjs').build();
} else if (cmd === 'serve') {
  let port = 8000;
  const rest = raw.slice(1);
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === '--port') port = Number(rest[++i]) || 8000;
    else if (rest[i].startsWith('--port=')) port = Number(rest[i].slice(7)) || 8000;
  }
  require('../lib/build.cjs').serve({ port });
} else if (cmd === 'gist') {
  require('../lib/gist.cjs').cli(raw.slice(1));
} else {
  usage();
  process.exit(cmd ? 1 : 0);
}
