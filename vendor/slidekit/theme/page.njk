<!DOCTYPE html>
<html lang="{{ site.lang or 'ja' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ title or site.title }}{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<style>
.lock-note { display: inline-block; padding: 8px 2px; color: var(--muted, #888); font-size: 0.9rem; }
</style>
{% block head %}{% endblock %}
</head>
<body>
<div class="wrap">
{% block header %}
<header>
  {% if site.kicker %}<p class="kicker">{{ site.kicker }}</p>{% endif %}
  <h1>{{ site.heading or site.title }}</h1>
  {% if site.subtitle %}<p class="sub">{{ site.subtitle }}</p>{% endif %}
  {% if site.credit %}<p class="sub">{{ site.credit }}</p>{% endif %}
</header>
{% endblock %}
{% block content %}{% endblock %}
</div>
<script>
(function () {
  var RELEASE = {% if release %}{{ release | dump | safe }}{% else %}null{% endif %};
  if (!RELEASE) return;
  var now = Date.now();
  function fmt(iso) {
    return new Date(iso).toLocaleString('{{ site.lang or "ja" }}' === 'ja' ? 'ja-JP' : undefined, {
      year: 'numeric', month: 'long', day: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
  }
  function cfgFor(key) {
    if (Object.prototype.hasOwnProperty.call(RELEASE, key)) return RELEASE[key];
    var num = parseInt(key, 10);
    if (!isNaN(num) && Object.prototype.hasOwnProperty.call(RELEASE, String(num))) {
      return RELEASE[String(num)];
    }
    return undefined;
  }
  document.querySelectorAll('[data-release]').forEach(function (el) {
    var cfg = cfgFor(el.dataset.release);
    if (!cfg) return;
    var status = cfg.status || (cfg.released_at ? 'scheduled' : 'public');
    if (status === 'public') return;
    var until = cfg.released_at;
    if (status === 'scheduled' && until && now >= new Date(until).getTime()) return;
    var note = document.createElement('span');
    note.className = 'lock-note';
    note.textContent =
      status === 'private' || !until
        ? '非公開です'
        : '公開は ' + fmt(until) + ' までお待ちください';
    if (el.classList.contains('links')) {
      el.replaceChildren(note);
    } else {
      el.style.display = 'none';
      el.insertAdjacentElement('afterend', note);
    }
  });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
